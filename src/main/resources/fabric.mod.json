{
  "schemaVersion": 1,
  "id": "cookie-addon",
  "version": "${version}",
  "name": "Cookie Addon",
  "description": "A delicious cookie-themed addon for Meteor Client.",
  "authors": [
    "sublarp"
  ],
  "contact": {
    "sources": "https://github.com/yourusername/cookie-addon"
  },
  "icon": "assets/cookie-addon/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.yourname.cookieaddon.CookieAddon"
    ]
  },
  "mixins": [
    "cookie-addon.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "210,180,140",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=17",
    "minecraft": "1.21.11",
    "meteor-client": "*"
  }
}
